# Copy this file to .env.local and fill in values for local development.
# Production values are set in the Vercel dashboard.

# Neon PostgreSQL connection string.
# If absent, falls back to embedded PGlite (data/introcourse-db).
DATABASE_URL=

# Resend API key for transactional email.
# If absent, emails are logged to the console instead.
RESEND_API_KEY=

# Public URL of this app — used for magic links, email buttons, etc.
APP_URL=https://introcourse.effectiefaltruisme.nl

# "From" address for outgoing email.
# Defaults to "EA Netherlands Fellowship <fellowship@effectiefaltruisme.nl>"
EMAIL_FROM=

# Vercel cron authentication secret.
# Set to a long random string; Vercel sends it as Authorization: Bearer <value>.
CRON_SECRET=

# HMAC secret for signing magic-link tokens (Stage 2).
# Generate with: openssl rand -hex 32
MAGIC_LINK_SECRET=

# Coordinator email — receives new application notifications (Stage 4).
ADMIN_EMAIL=programmes@effectiefaltruisme.nl

# Admin panel password — REQUIRED. Set a strong password here.
# Generate with: openssl rand -base64 16
ADMIN_PASSWORD=

# Default session duration in minutes (Stage 5).
DEFAULT_SESSION_DURATION_MINUTES=90

# Google Calendar integration — auto-creates a unique Google Meet per session.
# Leave blank to fall back to manually pasting a static Meet/Zoom link.
#
# Setup:
#   1. console.cloud.google.com → enable Calendar API → Service Accounts → create one → JSON key
#   2. Share the EA Google Calendar with the service account email ("Make changes to events")
#   3. Paste the values from the JSON key file below.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_KEY=
GOOGLE_CALENDAR_ID=programmes@effectiefaltruisme.nl

# Print every DB query to console with a running count.
# DB_LOG=1
